DBINFLUX=http://influxdb:8086
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=
DOCKER_INFLUXDB_INIT_PASSWORD=
DOCKER_INFLUXDB_INIT_ORG=soiltune
DOCKER_INFLUXDB_INIT_BUCKET=sensor-data
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=

MQTTBROKER=tcp://mosquito:1883
MQTTTOPIC="soiltune/telemetry/#"
MQTT_USERNAME=soiltune-server
MQTT_PASSWORD=

# Conta local de demonstração. O ID também identifica o tópico do dispositivo.
MQTT_DEVICE_ID=sensor-01
MQTT_DEVICE_PASSWORD=

# Use um segredo aleatório com pelo menos 32 caracteres.
API_KEY=
